# Copy to .env and fill in per environment. Every key here must be read
# through src/config/env.js — nothing else should touch process.env directly.

# development | staging | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=5000

# Frontend origin allowed by CORS — the Vite dev server by default.
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://localhost:27017/krozenda

# JWT signing secrets — generate strong random values per environment, never
# reuse across dev/staging/prod.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay — payments + Route split settlement. Client-owned account, must
# have Route provisioned (see project context §3.2 item 1, §4.1).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket — logistics (AWB, tracking, RTO). Client-owned account (§4.2).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Firebase — FCM push notifications ONLY. Do not use for Auth/Firestore
# (excluded, see §5 / §4.3). Client-owned project (§10).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMS India Hub — transactional SMS + all OTP delivery (§4.4). DLT template
# pre-registration is a client-owned dependency.
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=

# SMTP — order emails, invoices, verification links (§4.5). Client-owned
# SPF/DKIM/DMARC records required for deliverability.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
