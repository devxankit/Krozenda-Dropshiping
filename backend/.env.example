PORT=5000
ENV=development

MONGODB_URL=mongodb://localhost:27017/krozenda

JWT_SECRET=replace_with_a_long_random_string
JWT_ADMIN_SECRET=replace_with_a_long_random_string
JWT_VENDOR_SECRET=replace_with_a_long_random_string

BACKEND_URL=http://localhost:5000

# Comma-separated list of origins allowed by CORS in production
ALLOWED_ORIGINS=http://localhost:5173

# First super admin, created by `npm run seed` if no Admin document exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- Payment gateway (Razorpay) ---
# Use rzp_test_* keys locally, rzp_live_* only in production
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > secret for the endpoint pointed at
# /webhook/payments (payment.captured, payment.failed, refund.processed).
# This SAME secret is also used to verify /webhook/route-transfers (Razorpay
# Route's transfer.processed / transfer.failed / settlement.processed events)
# — see routeWebhookController.js. Razorpay signs both event families with
# the one webhook secret configured for the URL they're subscribed under; if
# this account ever configures a SEPARATE webhook URL/secret specifically for
# Route events, that will need its own env var (see the ASSUMPTION note at
# the top of Controllers/routeWebhookController.js).
# RAZORPAY_WEBHOOK_SECRET=

# Cron expression for how often Jobs/settlementReleaseJob.js polls for
# on-hold Razorpay Route transfers whose settlement window has passed and
# releases them (default shown). Only takes effect when Admin > Accounting >
# Settings has sellerSettlementMode set to AUTO.
# SETTLEMENT_RELEASE_CRON=*/30 * * * *

# Cron expression for Jobs/settlementAutomationJob.js: seller Route
# onboarding, re-checking auto-held batches, generating settlements,
# creating Route transfers and retrying failed ones (default shown). AUTO
# mode only, same as above.
# SETTLEMENT_AUTOMATION_CRON=0 */6 * * *

# How a seller settlement reaches the seller over Razorpay Route:
#   payment (default) — a held transfer against the buyer's captured payment;
#                       one batch per payment; COD batches stay manual.
#   direct            — a transfer from the platform's Razorpay balance; one
#                       batch per seller, COD included. Razorpay must enable
#                       direct transfers on the account first.
# RAZORPAY_ROUTE_TRANSFER_MODE=payment

# --- SMS India Hub — transactional OTP gateway (prod-only; dev/staging
# always uses the fixed OTP 123456, see userAuthController.requestOtp) ---
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=
# SMS_INDIA_HUB_ENTITY_ID=
# SMS_INDIA_HUB_TEMPLATE_ID=
# Comma-separated *extra* numbers that skip the SMS gateway even in production
# and always get the fixed OTP (QA handsets, app-store reviewers). Empty is
# fine: 1111111111 is pinned in userAuthController.PERMANENT_TEST_NUMBERS and
# always takes 123456 on every environment, whatever this is set to.
# TEST_PHONE_NUMBERS=

# --- WhatsApp order updates (BhashSMS, bhashsms.com) ---
# Sent to the buyer on order placed and on every status change — see
# services/whatsappService.js. Off unless WHATSAPP_ENABLED=true, and never
# sent while tests run (ENV=test), even with credentials present.
# WHATSAPP_ENABLED=false
# WHATSAPP_USER=
# WHATSAPP_PASS=
# WHATSAPP_SENDER=
# Optional; defaults to the HTTPS endpoint (keeps the password off plain HTTP)
# WHATSAPP_API_URL=https://bhashsms.com/api/sendmsgutil.php
# Meta-approved template NAMES (not their text). Wording and the variable
# order each one must be approved with: docs/WHATSAPP_TEMPLATES.md.
# DEFAULT is only used for "order placed" when ORDER_PLACED is empty; a
# status whose own template is empty is skipped, never sent with the wrong text.
# WHATSAPP_TEMPLATE_DEFAULT=order_update
# WHATSAPP_TEMPLATE_ORDER_PLACED=
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
# WHATSAPP_TEMPLATE_ORDER_SHIPPED=
# WHATSAPP_TEMPLATE_ORDER_DELIVERED=
# WHATSAPP_TEMPLATE_ORDER_CANCELLED=
# Login/registration OTP, sent together with the SMS — production only, same
# as the SMS (dev/staging and TEST_PHONE_NUMBERS never send). Empty = SMS only.
# Must be an Authentication-category template, see docs/WHATSAPP_TEMPLATES.md.
# WHATSAPP_TEMPLATE_OTP=
# Coupon offers sent from admin > Coupons > WhatsApp. Must be a Marketing-
# category template (`coupon_offer` in docs/WHATSAPP_TEMPLATES.md). Empty =
# the send button reports it is not set up.
# WHATSAPP_TEMPLATE_COUPON=
# Seller, reminder, refund, delivery and admin-alert templates. Each is
# skipped while empty — see docs/WHATSAPP_TEMPLATES.md for wording/variables.
# WHATSAPP_TEMPLATE_VENDOR_NEW_ORDER=
# WHATSAPP_TEMPLATE_VENDOR_SETTLEMENT=
# WHATSAPP_TEMPLATE_VENDOR_ACCOUNT=
# WHATSAPP_TEMPLATE_PAYMENT_PENDING=
# WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
# WHATSAPP_TEMPLATE_DELIVERY_FAILED=
# WHATSAPP_TEMPLATE_REFUND_PROCESSED=
# WHATSAPP_TEMPLATE_CART_REMINDER=
# WHATSAPP_TEMPLATE_REVIEW_REQUEST=
# WHATSAPP_TEMPLATE_ADMIN_ALERT=

# --- Admin alerts (services/adminAlertService.js) ---
# Every alert goes to the admin panel (toast) and to admins' push devices.
# URGENT ones (CJ order failed, refund failed, seller payout failed, payment
# captured with no order) also go on WhatsApp to these numbers, comma-separated.
# ADMIN_ALERT_WHATSAPP_NUMBERS=9876543210,9123456780
# An order at or above this total (rupees) raises a "high-value order" alert.
# ADMIN_HIGH_VALUE_ORDER_AMOUNT=10000

# --- Engagement jobs (Jobs/engagementJob.js) ---
# Payment/cart/review reminders every 15 min; wishlist and low-stock hourly.
# ENGAGEMENT_JOBS_ENABLED=true
# ENGAGEMENT_CRON=*/15 * * * *
# ENGAGEMENT_HOURLY_CRON=7 * * * *
# Low-stock alert level for products that have no lowStockThreshold of their own.
# LOW_STOCK_DEFAULT_THRESHOLD=5

# (Shipping provider configuration lives in the Shiprocket section at the
# bottom of this file — the old SHIPPING_API_KEY placeholder was never read.)

# --- Firebase Cloud Messaging (Push Notifications) ---
# Base64 encoded string of firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Database backups (nightly, gzipped JSON dump of every collection) ---
# Absolute or relative path where backup files are stored on this server
# BACKUP_DIR=./backups
# How long to keep old backups before they're pruned
# BACKUP_RETENTION_DAYS=30
# Cron expression for the nightly run (default: 01:30 server time)
# BACKUP_CRON_SCHEDULE=30 1 * * *

# --- AI Assistant (Google Gemini) ---
# Server-side ONLY. This key must never be copied into frontend/.env or any
# VITE_* variable — the browser calls POST /user/ai/chat and the backend
# holds the key (see services/geminiClient.js, the only reader).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Shipping — Shiprocket
# ---------------------------------------------------------------------------
# Carrier API base. Leave as-is unless Shiprocket tells you otherwise.
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in

# The PLATFORM's Shiprocket account, used for sellers who have not connected
# an account of their own (and only when Platform Fallback is enabled in
# Admin > Shipping Settings). These must be API-user credentials created in
# the Shiprocket panel under Settings > API > Configure, NOT your panel login.
# Backend only — never exposed to any frontend, never returned by any endpoint.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Encrypts SELLERS' own Shiprocket passwords at rest (AES-256-GCM).
# Required only if you let sellers connect their own accounts.
# Generate with:  openssl rand -hex 32
# Rotating this invalidates every stored seller credential — they must reconnect.
SHIPROCKET_CREDENTIAL_ENCRYPTION_KEY=

# Shared secret for the Shiprocket tracking webhook. You choose this value and
# enter the SAME value in the Shiprocket panel under Settings > API > Webhook
# as the `x-api-key` header. Shiprocket does not sign webhooks, so this shared
# secret is the only thing standing between the endpoint and the public
# internet — make it long and random, and treat the payload as untrusted even
# when it matches.
# Generate with:  openssl rand -hex 32
SHIPROCKET_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# CJ Dropshipping (Admin-only fulfillment provider — see project memory
# "cj-dropshipping-architecture" for the full plan)
# ---------------------------------------------------------------------------
# CJ API base. Leave as-is unless CJ tells you otherwise.
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0

# Central rate-limit gate shared by every CJ service (cjRequestManager).
# CJ allows 1 request/second per account. Defaults shown; only override if
# CJ's own limits change.
# CJ_MIN_REQUEST_INTERVAL_MS=1100
# CJ_MAX_CONCURRENCY=1

# CJ API points (services/cj/cjPointsGuard.js): 50,000/day, refilled per
# minute, reset 00:00 UTC. Most reads cost 10, a catalogue page 50.
# Background jobs stand down below these balances so the admin catalogue and
# order placement keep working. Defaults shown.
# CJ_BACKGROUND_POINTS_RESERVE=5000
# CJ_TRACKING_POINTS_RESERVE=1000
# After CJ reports "Insufficient API points", no CJ call is made for this long.
# CJ_POINTS_PAUSE_MS=300000
# Stock/price sync schedule — ~30 points per onboarded product per run.
# CJ_SYNC_CRON=0 * * * *

# CJ account email + API key are entered from Admin > CJ Dropshipping >
# Settings (POST /admin/cj/settings/connect) and stored encrypted in Mongo —
# there is no env var for them. They reuse SHIPROCKET_CREDENTIAL_ENCRYPTION_KEY
# above for at-rest encryption (same AES-256-GCM secretBox util); set that key
# even if this deployment has no seller-owned Shiprocket accounts.

# Shared secret for the CJ webhook, once implemented (Phase 4). Placeholder
# for now — CJ documents HMAC-SHA256 signature verification, not a shared
# static token like Shiprocket's.
CJ_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (SMTP via Nodemailer) — services/emailService.js
# ---------------------------------------------------------------------------
# Vendor onboarding mails: registration received / under review, account
# activated, application rejected, and a KYC document rejected (with reason).
# Off unless EMAIL_ENABLED=true, and never sent while tests run (ENV=test).
# Any SMTP provider works (Gmail app password, Zoho, SES, Brevo...).
# EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Optional; defaults to true only for port 465
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Defaults to "Krozenda <SMTP_USER>"
# EMAIL_FROM=Krozenda <no-reply@krozenda.com>
# Public URL of the web frontend, used for the Log in / Upload documents
# buttons in emails, links inside WhatsApp reminders, and — when it is https —
# the page a tapped push notification opens. Empty = emails go out without the
# buttons and WhatsApp says "the Krozenda app" instead of a link.
# FRONTEND_URL=http://localhost:5173
