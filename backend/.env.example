PORT=5000
ENV=development

MONGODB_URL=mongodb://localhost:27017/krozenda

JWT_SECRET=replace_with_a_long_random_string
JWT_ADMIN_SECRET=replace_with_a_long_random_string
JWT_VENDOR_SECRET=replace_with_a_long_random_string

BACKEND_URL=http://localhost:5000

# Comma-separated list of origins allowed by CORS in production
ALLOWED_ORIGINS=http://localhost:5173

# First super admin, created by `npm run seed` if no Admin document exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- Payment gateway (Razorpay) ---
# Use rzp_test_* keys locally, rzp_live_* only in production
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > secret for the endpoint pointed at
# /webhook/payments (payment.captured, payment.failed, refund.processed).
# RAZORPAY_WEBHOOK_SECRET=

# --- SMS India Hub — transactional OTP gateway (prod-only; dev/staging
# always uses the fixed OTP 123456, see userAuthController.requestOtp) ---
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=
# SMS_INDIA_HUB_ENTITY_ID=
# SMS_INDIA_HUB_TEMPLATE_ID=
# Comma-separated *extra* numbers that skip the SMS gateway even in production
# and always get the fixed OTP (QA handsets, app-store reviewers). Empty is
# fine: 1111111111 is pinned in userAuthController.PERMANENT_TEST_NUMBERS and
# always takes 123456 on every environment, whatever this is set to.
# TEST_PHONE_NUMBERS=

# (Shipping provider configuration lives in the Shiprocket section at the
# bottom of this file — the old SHIPPING_API_KEY placeholder was never read.)

# --- Firebase Cloud Messaging (Push Notifications) ---
# Base64 encoded string of firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Database backups (nightly, gzipped JSON dump of every collection) ---
# Absolute or relative path where backup files are stored on this server
# BACKUP_DIR=./backups
# How long to keep old backups before they're pruned
# BACKUP_RETENTION_DAYS=30
# Cron expression for the nightly run (default: 01:30 server time)
# BACKUP_CRON_SCHEDULE=30 1 * * *

# --- AI Assistant (Google Gemini) ---
# Server-side ONLY. This key must never be copied into frontend/.env or any
# VITE_* variable — the browser calls POST /user/ai/chat and the backend
# holds the key (see services/geminiClient.js, the only reader).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Shipping — Shiprocket
# ---------------------------------------------------------------------------
# Carrier API base. Leave as-is unless Shiprocket tells you otherwise.
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in

# The PLATFORM's Shiprocket account, used for sellers who have not connected
# an account of their own (and only when Platform Fallback is enabled in
# Admin > Shipping Settings). These must be API-user credentials created in
# the Shiprocket panel under Settings > API > Configure, NOT your panel login.
# Backend only — never exposed to any frontend, never returned by any endpoint.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Encrypts SELLERS' own Shiprocket passwords at rest (AES-256-GCM).
# Required only if you let sellers connect their own accounts.
# Generate with:  openssl rand -hex 32
# Rotating this invalidates every stored seller credential — they must reconnect.
SHIPROCKET_CREDENTIAL_ENCRYPTION_KEY=

# Shared secret for the Shiprocket tracking webhook. You choose this value and
# enter the SAME value in the Shiprocket panel under Settings > API > Webhook
# as the `x-api-key` header. Shiprocket does not sign webhooks, so this shared
# secret is the only thing standing between the endpoint and the public
# internet — make it long and random, and treat the payload as untrusted even
# when it matches.
# Generate with:  openssl rand -hex 32
SHIPROCKET_WEBHOOK_TOKEN=
