# Copy to .env and fill in per environment. Every VITE_* key referenced by
# src/config/env.js must have an entry here — this file is the documentation.

# Display name shown in the UI (browser title, headers).
VITE_APP_NAME=Krozenda

# development | staging | production
VITE_APP_ENV=development

# Base URL of the backend API (Express), e.g. http://localhost:4000/api/v1
VITE_API_BASE_URL=

# Axios request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Dev convenience only — prefills the admin login form so nobody has to
# retype the seeded admin's credentials while testing locally. Leave blank
# in staging/production.
VITE_DEFAULT_ADMIN_EMAIL=
VITE_DEFAULT_ADMIN_PASSWORD=

# Razorpay publishable key id (safe for client exposure; NOT the key secret).
# Client-owned dependency — see project context §10.
VITE_RAZORPAY_KEY_ID=

# Firebase web config — FCM push notifications ONLY.
# Do not use for Firebase Auth / Firestore / Storage (excluded, see §5 / §4.3).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
