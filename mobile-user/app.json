{
  "expo": {
    "name": "Krozenda",
    "slug": "krozenda-user",
    "scheme": "krozenda",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8fafc",
    "android": {
      "package": "com.krozenda.user",
      "versionCode": 40,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#EB2527",
        "foregroundImage": "./assets/adaptive-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8E4692",
          "defaultChannel": "webview_notifications"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Krozenda to access your photos to attach images to reviews, tickets and your profile.",
          "cameraPermission": "Allow Krozenda to use the camera to take photos for reviews, tickets and your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Krozenda to use your location to fill in your delivery address."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2073cbfb-0843-4d1d-ae55-2db505d7af54"
      }
    },
    "owner": "rehan121"
  }
}