# Copy to .env and fill in per environment. Same keys as frontend/.env.example, with the
# EXPO_PUBLIC_ prefix (Expo inlines only EXPO_PUBLIC_* into the app at build time).
# Public values only - never put backend secrets here.

# Display name shown in the UI
EXPO_PUBLIC_APP_NAME=Krozenda

# development | staging | production
EXPO_PUBLIC_APP_ENV=production

# Base URL of the backend API (Express)
EXPO_PUBLIC_API_BASE_URL=https://krozenda.com/api

# Public web origin: relative image URLs (/images/..., /uploads/...) and share links resolve against it
EXPO_PUBLIC_WEB_ORIGIN=https://krozenda.com

# Axios request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Razorpay publishable key id (safe for client exposure; NOT the key secret).
# Optional fallback - the key normally comes from the backend create-order response.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Firebase config - FCM push notifications ONLY (values from android/app google-services.json,
# which is wired through app.json). Informational for the app code.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=krozenda-a62bb
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=778748845767
EXPO_PUBLIC_FIREBASE_APP_ID=1:778748845767:android:334a7a936d430abf4928e2
